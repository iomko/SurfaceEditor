@startuml AdditionLayerDependencies

package "MeshAdderCallablesPlugin"{
    class MeshVaoInitCallable
    class SceneMeshAdderCallable
}
MeshAdderCallablesPlugin --> AddNodesToOutlinerLayerPlugin


package "AddCubePlugin" {
    class AddCubeCommand
    class AddCubeCallback
    class CubeVertexGenCallable

    AddCubeCallback --> CubeVertexGenCallable      
}
AddCubePlugin --> MeshAdderCallables

package "AddPlanePlugin" {
    class AddPlaneCommand
    class AddPlaneCallback
    class PlaneVertexGenCallable

    AddPlaneCallback --> PlaneVertexGenCallable
}
AddPlanePlugin --> MeshAdderCallables

package "FetchSurfacePlugin" {
    class FetchSurfaceCommand
    class FetchSurfaceCallback
    class FetchedSurfaceVertexGenCallable

    FetchSurfaceCallback --> FetchedSurfaceVertexGenCallable
}
FetchSurfacePlugin --> MeshAdderCallables

class AdditionLayer
AdditionLayer --> AddCubePlugin
AdditionLayer --> AddPlanePlugin
AdditionLayer --> FetchSurfacePlugin

@enduml